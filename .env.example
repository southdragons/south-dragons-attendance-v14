# Both empty = demo. Any nonempty value enables GAS mode (fails closed on error).
# GAS Web App deployment URL. Do not use the spreadsheet URL or /dev URL.
NUXT_GAS_WEB_APP_URL=
# API_KEY from Apps Script > Project Settings > Script Properties.
# Server-only secret. Never prefix it with NUXT_PUBLIC_.
NUXT_GAS_API_KEY=

# v1.4: supabase (default), gas (temporary legacy), or demo (local sample only).
NUXT_PUBLIC_DATA_BACKEND=supabase
NUXT_PUBLIC_SUPABASE_URL=
NUXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# GitHub project Pages: /repository-name/ ; account Pages/custom domain: /
NUXT_APP_BASE_URL=/
